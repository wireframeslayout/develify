export LANG=ja_JP.UTF-8
export CLICOLOR=1

## Homebrew (Apple Silicon / Intel)
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/bin:$PATH"
export PATH="/usr/local/sbin:$PATH"

## dircolors (GNU coreutils 経由でのみ利用可能)
if command -v gdircolors >/dev/null 2>&1; then
    eval "$(gdircolors ~/.dircolors-solarized/dircolors.ansi-universal)"
elif command -v dircolors >/dev/null 2>&1; then
    eval "$(dircolors ~/.dircolors-solarized/dircolors.256dark)"
else
    export LSCOLORS=gxfxcxdxbxegedabagacad
fi

## anyenv
if [ -e "$HOME/.anyenv" ]; then
    export ANYENV_ROOT="$HOME/.anyenv"
    export PATH="$ANYENV_ROOT/bin:$PATH"
    if command -v anyenv 1>/dev/null 2>&1; then
        eval "$(anyenv init -)"
    fi
fi

## exa alias
if command -v exa >/dev/null 2>&1; then
    alias ls='exa --icons'
    alias ll='exa --icons -la'
    alias l1='exa -1'
    alias lt='exa -Ta --icons -I "node_modules|.git|.cache|vendor|tmp"'
    alias ltl='lt | less -r'
else
    alias ll='ls -la'
    alias l1='ls -1'
    alias lt='tree -I "node_modules|.git|.cache|vendor|tmp"'
    alias ltl='lt | less -r'
fi

## prompt engine (starship / oh-my-posh)
if [ -r ~/conf.d/init_prompt.bash ]; then
    source ~/conf.d/init_prompt.bash
fi
